# Variáveis de ambiente do backend
# Copie este arquivo para .env e preencha as chaves necessárias.

# --- IA para mapeamento de habilidades ---
# Provedores suportados: openai, groq, gemini
# Deixe IA_API_KEY vazio ou comente para usar o fallback difflib (gratuito, 100% offline).
IA_PROVIDER=groq
IA_API_KEY=
IA_MODEL=llama-3.1-8b-instant

# Dicas de provedores gratuitos (sem cartão internacional, sujeito a mudanças):
# - Groq: cria conta em groq.com, gera API key, modelos como llama-3.1-8b-instant
# - Gemini: cria conta em ai.google.dev, gera API key, modelos como gemini-1.5-flash
# - OpenAI: requer cartão internacional; use apenas se já tiver conta

# --- URL do frontend (usado no CORS e em links, se necessário) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
